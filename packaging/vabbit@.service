# Runs the agent for an enrolled interface. Enroll once with
# `sudo vabbit up --dry-run --server ... --setup-key ...`, then:
#   systemctl enable --now vabbit@vb0
[Unit]
Description=Vabbit WireGuard agent (%i)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/vabbit up --iface %i
Restart=on-failure
RestartSec=10
# Needs to manage network interfaces; everything else is locked down.
# NET_BIND_SERVICE lets a hub serve its TCP relay on port 443.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
# /etc/hosts: the names of the other devices (see --domain); "-" = fine if it is missing.
# It is bind-mounted here, so it is rewritten in place (rename gives EBUSY/EROFS).
ReadWritePaths=/var/lib/vabbit /proc/sys/net/ipv4/conf -/etc/hosts
# Control socket for `vabbit status` / `wg show`.
RuntimeDirectory=wireguard
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
DeviceAllow=/dev/net/tun rw
StateDirectory=vabbit
StateDirectoryMode=0700
ProtectHome=true
PrivateTmp=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
